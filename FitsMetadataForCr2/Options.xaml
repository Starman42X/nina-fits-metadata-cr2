<ResourceDictionary
    x:Class="FitsMetadataForCr2.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Shown under Options > Plugins. Key must be "<plugin name>_Options"; DataContext is the FitsMetadataForCr2Plugin instance  -->
    <DataTemplate x:Key="FITS Metadata for CR2_Options">
        <StackPanel Margin="5" Orientation="Vertical">
            <StackPanel.Resources>
                <Style x:Key="Label" TargetType="TextBlock">
                    <Setter Property="Width" Value="280" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </StackPanel.Resources>

            <TextBlock Margin="0,0,0,10" FontWeight="Bold" TextWrapping="Wrap"
                       Text="N.I.N.A. currently saves FITS/XISF/TIFF. Set Options > Imaging > File format to RAW to save CR2 files; this plugin only acts on those.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRawFileTypeSelected}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="Write FITS metadata into the raw file" ToolTip="Stored as XMP inside the CR2. The raw image data is not changed." />
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.EmbedInRawFile}" />
            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="Also write an .xmp sidecar file" ToolTip="IMG_0001.CR2 gets IMG_0001.xmp next to it. Needed for raw formats that are not TIFF-based, such as CR3." />
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.WriteSidecar}" />
            </StackPanel>

            <TextBlock Margin="0,10,0,5" Text="{Binding Status}" TextWrapping="Wrap" />

            <TextBlock Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="Each saved raw file gets the same keywords N.I.N.A. writes into FITS headers (OBJECT, RA, DEC, IMAGETYP, FILTER, FOCALLEN, SITELAT, CCD-TEMP, ...), as XMP properties with the prefix 'fits'. Read them with e.g.  exiftool -XMP-fits:all IMG_0001.CR2" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
